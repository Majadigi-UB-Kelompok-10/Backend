FROM golang:1.26.2-alpine

WORKDIR /app

RUN apk add --no-cache git

# Build cache only - air binary goes to /root/go/bin, deps not needed at runtime
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
ENV GONOSUMDB="*"
ENV GOPROXY="https://proxy.golang.org,direct"
# No cache mount: modules baked into image layer so Docker init-copies to named volume on first run
RUN go mod download

CMD ["air", "-c", ".air.toml"]
