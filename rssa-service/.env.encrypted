DB_MAX_CONNS=50
DB_MIN_CONNS=5
DB_MAX_LIFETIME=1h
DB_MAX_IDLE_TIME=30m
DB_QUERY_TIMEOUT=5s

BODY_LIMIT_BYTES=4194304
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m

LOG_LEVEL=debug         
ENABLE_PPROF=true       
PPROF_PORT=6060