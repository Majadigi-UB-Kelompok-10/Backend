GATEWAY_DATABASE_URL="postgres://postgres:majadigiHebatBanget@majadigi-gateway-db:5432/majadigi_db?pool_max_conns=50&sslmode=disable"
REDIS_URL=redis://rssa-redis:6379/0
PORT="8080"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
ENVIRONMENT="development"

POSTGRES_USER=dzaky
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rssa_db

